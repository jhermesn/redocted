{"id":"mediaconnect","corpus":"aws","title":"AWS Elemental MediaConnect","sourceUrl":"https://docs.aws.amazon.com/mediaconnect/latest/ug/what-is.html","license":"AWS Documentation © Amazon Web Services, Inc.","blocks":[{"kind":"h1","text":"AWS Elemental MediaConnect"},{"kind":"p","text":"AWS Elemental MediaConnect is a high-quality, reliable live video transport and routing service that you can use to ingest, distribute, and route live video within and beyond the AWS Cloud. MediaConnect combines the reliability, security, and visibility of traditional broadcast infrastructure with the flexibility, scalability, and cost-effectiveness of cloud-based transmission."},{"kind":"p","text":"In AWS Elemental MediaConnect, you can work with live video in two ways: you can create a flow to establish a transport between a source and one or more outputs, or you can create router inputs and outputs to dynamically route video between sources and destinations in real time. You can also share content with other AWS accounts by creating entitlements. This allows the receiving account to create a flow using your content as the source."},{"kind":"p","text":"With AWS Elemental MediaConnect, you can do the following:"},{"kind":"li","text":"Ingest live video into the AWS Cloud from on-premises encoders or remote sources."},{"kind":"li","text":"Distribute live video to multiple destinations inside or outside the AWS Cloud."},{"kind":"li","text":"Dynamically route live video streams between cloud production tools, encoders, and third-party services by using the MediaConnect router."},{"kind":"li","text":"Transport uncompressed video at ultra-low latency by using AWS Cloud Digital Interface (AWS CDI)."},{"kind":"li","text":"Receive and distribute video from NDI®-enabled devices and software by using Network Device Interface (NDI)."},{"kind":"li","text":"Subscribe to a live video stream that is supplied by another AWS account."},{"kind":"li","text":"Send content from one AWS Region to another."},{"kind":"li","text":"Normalize diverse contribution protocols and formats for downstream cloud production services."}],"lemmas":{"elementals":["elementals","elemental"],"highs":["high","highs"],"higher":["higher","high"],"highest":["highest","high"],"qualities":["quality","qualities"],"reliables":["reliables","reliable"],"lives":["life","live","lives"],"living":["living","live"],"lived":["lived","live"],"videos":["video","videos"],"transports":["transport","transports"],"transported":["transported","transport"],"transporting":["transporting","transport"],"routing":["routing","rout"],"routings":["routings","routing"],"routs":["rout","routs"],"routed":["routed","rout"],"serviced":["serviced","service"],"servicing":["servicing","service"],"uses":["use","uses"],"used":["used","use"],"ingests":["ingests","ingest"],"distributes":["distributes","distribute"],"distributing":["distributing","distribute"],"distributed":["distributed","distribute"],"routes":["route","routes"],"withins":["withins","within"],"beyonds":["beyonds","beyond"],"clouds":["cloud","clouds"],"clouding":["clouding","cloud"],"clouded":["clouded","cloud"],"combines":["combine","combines"],"combined":["combined","combine"],"combining":["combining","combine"],"reliabilities":["reliability","reliabilities"],"securities":["security","securities"],"visibilities":["visibility","visibilities"],"traditionals":["traditionals","traditional"],"broadcasts":["broadcast","broadcasts"],"broadcasting":["broadcasting","broadcast"],"infrastructures":["infrastructure","infrastructures"],"flexibilities":["flexibility","flexibilities"],"scalabilities":["scalability","scalabilities"],"costs":["cost","costs"],"costing":["costing","cost"],"effectivenesses":["effectiveness","effectivenesses"],"based":["based","base"],"baseds":["baseds","based"],"bases":["base","bases"],"basing":["basing","base"],"transmissions":["transmission","transmissions"],"works":["work","works"],"worked":["worked","work"],"working":["working","work"],"two