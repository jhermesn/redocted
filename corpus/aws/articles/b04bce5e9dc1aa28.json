{"id":"savingsplans","corpus":"aws","title":"Savings Plans","sourceUrl":"https://docs.aws.amazon.com/savingsplans/latest/userguide/what-is-savings-plans.html","license":"AWS Documentation © Amazon Web Services, Inc.","blocks":[{"kind":"h1","text":"Savings Plans"},{"kind":"p","text":"Savings Plans provide savings beyond On-Demand rates in exchange for a commitment of using a specified amount of compute power (measured per hour) for a one or three year period."},{"kind":"li","text":"One year: A year is defined as 365 days (31,536,000 seconds)."},{"kind":"li","text":"Three years: Three years is defined as 1,095 days (94,608,000 seconds)."},{"kind":"p","text":"Savings Plans offer a flexible pricing model that provides savings on AWS usage. You can save up to 72% on your AWS compute workloads. Compute Savings Plans provide lower prices on Amazon EC2 instance usage regardless of instance family, instance size, OS, tenancy, or AWS Region. This also applies to AWS Fargate and AWS Lambda usage. SageMaker AI Savings Plans provide you with lower prices for your Amazon SageMaker AI instance usage, regardless of your instance family, instance size, component, or AWS Region."},{"kind":"p","text":"You can manage your plans by using recommendations, performance reporting, and budget alerts in AWS Cost Explorer."},{"kind":"p","text":"When you sign up for Savings Plans, the prices you'll pay for usage stays the same through the plan term. You can pay for your commitment using All upfront, Partial upfront, or No upfront payment options."},{"kind":"p","text":"To get started, use AWS Cost Explorer to view your recommended Savings Plans commitment, refresh Savings Plans recommendations, purchase Savings Plans, manage your Savings Plans, and view your historical AWS usage. These recommendations make it easy for you to know the optimal Savings Plans commitment level for you. You can customize the recommendation to meet your needs and then purchase your Savings Plan. To see a full list of AWS services that are eligible for Savings Plans, see Services eligible for Savings Plans benefits."}],"lemmas":{"savings":["saving","savings"],"saving":["saving","save"],"plans":["plan","plans"],"planned":["planned","plan"],"planning":["planning","plan"],"planed":["planed","plan"],"provided":["provided","provide"],"providing":["providing","provide"],"beyonds":["beyonds","beyond"],"demands":["demand","demands"],"demanded":["demanded","demand"],"demanding":["demanding","demand"],"rates":["rate","rates"],"exchanges":["exchange","exchanges"],"exchanging":["exchanging","exchange"],"exchanged":["exchanged","exchange"],"commitments":["commitment","commitments"],"using":["using","use"],"usings":["using","usings"],"uses":["use","uses"],"used":["used","use"],"specified":["specified","specify"],"specifieds":["specifieds","specified"],"specifies":["specifies","specify"],"specifying":["specifying","specify"],"amounts":["amount","amounts"],"amounted":["amounted","amount"],"amounting":["amounting","amount"],"computes":["computes","compute"],"computing":["computing","compute"],"computed":["computed","compute"],"powers":["power","powers"],"powered":["powered","power"],"powering":["powering","power"],"measured":["measured","measure"],"measureds":["measureds","measured"],"measures":["measure","measures"],"measuring":["measuring","measure"],"pers":["pers","per"],"hours":["hour","hours"],"ones":["one","ones"],"threes":["three","threes"],"periods":["period","periods"],"defined":["defined","define"],"defineds":["defineds","defined"],"defines":["defines","define"],"defining":["defining","define"],"days":["day","days"],"seconds":["second","seconds"],"years":["year","years"],"offers":["offer","offers"],"offering":["offering","offer"],"offered":["offered","offer"],"flexibles":["flexibles","flexible"],"pricing":["pricing","price"],"pricings":["pricing","pricings"],"priced":["priced","price"],"models":["model","models"],"modeling":["modeling","model"],"modeled":["modeled","model"],"provides":["