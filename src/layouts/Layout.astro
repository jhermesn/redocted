---
import '../styles/global.css';
import { Font } from 'astro:assets';
import bannerImage from '../assets/banner.png';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import pkg from '../../package.json';
import { DEFAULT_LOCALE, getMessages, HTML_LANG, LOCALES, OG_LOCALE, parseLocale } from '../i18n/index.ts';

const locale = parseLocale(Astro.currentLocale);
const t = getMessages(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = getAbsoluteLocaleUrl(locale);
const banner = { url: new URL(bannerImage.src, Astro.site).href, width: bannerImage.width, height: bannerImage.height };

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Redocted',
  url: canonical,
  description: t.pageDescription,
  inLanguage: HTML_LANG[locale],
  applicationCategory: 'GameApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  image: banner.url,
  author: { '@type': 'Person', name: pkg.author.name, url: pkg.author.url },
  license: 'https://opensource.org/licenses/MIT',
  codeRepository: pkg.repository.url.replace(/^git\+/, '').replace(/\.git$/, ''),
};
---

<!doctype html>
<html lang={HTML_LANG[locale]} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.pageTitle}</title>
    <meta name="description" content={t.pageDescription} />
    <meta name="author" content={pkg.author.name} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((alternate) => <link rel="alternate" hreflang={HTML_LANG[alternate]} href={getAbsoluteLocaleUrl(alternate)} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(DEFAULT_LOCALE)} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <Font cssVariable="--font-plex-mono" preload />
    <meta name="theme-color" content="#06090d" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Redocted" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {LOCALES.filter((other) => other !== locale).map((other) => <meta property="og:locale:alternate" content={OG_LOCALE[other]} />)}
    <meta property="og:title" content={t.pageTitle} />
    <meta property="og:description" content={t.pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={banner.url} />
    <meta property="og:image:width" content={String(banner.width)} />
    <meta property="og:image:height" content={String(banner.height)} />
    <meta property="og:image:alt" content="Redocted — Guess the Docs!" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.pageTitle} />
    <meta name="twitter:description" content={t.pageDescription} />
    <meta name="twitter:image" content={banner.url} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-dvh antialiased">
    <slot />
  </body>
</html>
