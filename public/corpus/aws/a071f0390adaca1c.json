{"id":"notifications","corpus":"aws","title":"AWS User Notifications","sourceUrl":"https://docs.aws.amazon.com/notifications/latest/userguide/what-is-service.html","license":"AWS Documentation © Amazon Web Services, Inc.","blocks":[{"kind":"h1","text":"AWS User Notifications"},{"kind":"p","text":"AWS User Notifications is an AWS service that provides a central location for managing your AWS notifications. There are two types of AWS notifications you can manage using User Notifications:"},{"kind":"li","text":"AWS managed notifications – Notifications generated by default. AWS services such as AWS Health, AWS Marketplace, and AWS Billing and Cost Management send managed notifications through User Notifications."},{"kind":"li","text":"User-configured notifications (UCNs) – Notifications generated by notification configurations that you create. You can generate notifications for Amazon CloudWatch alarms, Support case, and more based on rules that you specify."},{"kind":"p","text":"You can receive notifications for through multiple channels, including the Console Notification Center (default), email, Amazon Q Developer in chat applications, AWS Console Mobile App push notifications, or the User Notifications API."},{"kind":"p","text":"You can use User Notifications to filter and view AWS notifications to your specifications. You can filter your notifications by service and view them across accounts, AWS Regions, and services. Notifications include a detailed overview with direct links to relevant console resource pages."},{"kind":"h2","text":"How User Notifications works"},{"kind":"p","text":"For AWS managed notifications, User Notifications integrates with AWS services such as AWS Health, AWS Marketplace, and AWS Billing and Cost Management to send notifications to the AWS Management Console Notifications Center and your chosen delivery channels."},{"kind":"p","text":"For UCNs, User Notifications uses Amazon EventBridge to send notifications about events from AWS services to the AWS Management Console Notifications Center and your chosen delivery channels."},{"kind":"h2","text":"Sign up for an AWS account"},{"kind":"p","text":"To get started with AWS, you need an AWS account. For information about creating an AWS account, see Getting started with an AWS account in the AWS Account Management Reference Guide."},{"kind":"h2","text":"Accessing User Notifications"},{"kind":"p","text":"You can access User Notifications through the AWS Management Console."}],"lemmas":{"users":["user","users"],"notifications":["notification","notifications"],"serviced":["serviced","service"],"servicing":["servicing","service"],"provides":["provides","provide"],"provided":["provided","provide"],"providing":["providing","provide"],"centrals":["central","centrals"],"locations":["location","locations"],"managing":["managing","manage"],"managings":["managings","managing"],"manages":["manages","manage"],"twos":["two","twos"],"types":["type","types"],"typed":["typed","type"],"typing":["typing","type"],"using":["using","use"],"usings":["using","usings"],"used":["used","use"],"managed":["managed","manage"],"manageds":["manageds","managed"],"generated":["generated","generate"],"generateds":["generateds","generated"],"generates":["generates","generate"],"generating":["generating","generate"],"defaults":["default","defaults"],"services":["service","services"],"marketplaces":["marketplace","marketplaces"],"billing":["billing","bill"],"billings":["billing","billings"],"bills":["bill","bills"],"billed":["billed","bill"],"costs":["cost","costs"],"costing":["costing","cost"],"managements":["management","managements"],"sends":["sends","send"],"sending":["sending","send"],"sent":["sent","send"],"configured":["configured","configure"],"configureds":["configureds","configured"],"configures":["configures","configure"],"ucns":["ucns","ucn"],"configurations":["configuration","configurations"],"creates":["creates","create"],"created":["created","create"],"amazons":["amazon","amaz