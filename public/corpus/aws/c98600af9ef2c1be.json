{"id":"ssm-sap","corpus":"aws","title":"AWS Systems Manager for SAP","sourceUrl":"https://docs.aws.amazon.com/ssm-sap/latest/userguide/what-is-ssm-for-sap.html","license":"AWS Documentation © Amazon Web Services, Inc.","blocks":[{"kind":"h1","text":"AWS Systems Manager for SAP"},{"kind":"p","text":"AWS Systems Manager for SAP is an automation capability to manage and operate your SAP applications on AWS. It provides a seamless integration between AWS services and SAP applications running on AWS. Systems Manager for SAP is available to use with AWS APIs. For more information, see Systems Manager for SAP API Reference Guide."},{"kind":"p","text":"With Systems Manager for SAP, you can backup and restore SAP HANA databases on Amazon EC2 with AWS Backup. For more information, see Get Started."},{"kind":"h2","text":"Features"},{"kind":"p","text":"AWS Systems Manager for SAP provides the following features for your SAP workloads running on Amazon EC2."},{"kind":"li","text":"Register and discover SAP applications"},{"kind":"li","text":"List discovered SAP applications"},{"kind":"li","text":"List configurations of discovered SAP applications"},{"kind":"li","text":"Integration with AWS Backup – using https://console.aws.amazon.com/backup, enable automatic backup and restore operations of SAP HANA databases."},{"kind":"li","text":"Run configuration checks on your registered SAP applications to validate their setup and identify configuration issues."},{"kind":"li","text":"Integration with AWS EventBridge Scheduler – using AWS EventBridge Scheduler, schedule SAP management operations such as start, stop, and configuration check operations."},{"kind":"li","text":"Integration with AI assistants – With the AWS for SAP Management MCP Server, you can manage and monitor SAP applications through natural language conversation with an MCP-compatible AI assistant."},{"kind":"h2","text":"Supported Regions"},{"kind":"p","text":"For more information on currently supported regions for AWS Systems Manager for SAP, see Systems Manager for SAP endpoints and quotas."},{"kind":"p","text":"Supported services by AWS Region contains the currently supported Regions where SAP HANA database backups on Amazon EC2 instances are available with AWS Backup."},{"kind":"h2","text":"Related services"},{"kind":"p","text":"The following services are related to AWS Systems Manager for SAP on AWS."},{"kind":"li","text":"AWS Backup"},{"kind":"li","text":"SAP HANA on AWS"},{"kind":"li","text":"AWS Backint Agent for SAP HANA"},{"kind":"li","text":"AWS EventBridge Scheduler"},{"kind":"h2","text":"Pricing"},{"kind":"p","text":"AWS Systems Manager for SAP follows a simple pricing model where you pay only for the features you use. There are no upfront commitments or minimum fees"},{"kind":"h3","text":"Free Features"},{"kind":"li","text":"SAP application registration and management"},{"kind":"li","text":"Application-aware start and stop operations"},{"kind":"li","text":"Basic application monitoring and insights"},{"kind":"h3","text":"Usage-Based Features"},{"kind":"p","text":"SAP HANA Database Backup with AWS Backup integration"},{"kind":"li","text":"No additional charge for backup orchestration through Systems Manager for SAP"},{"kind":"li","text":"Pay only for AWS Backup storage"},{"kind":"li","text":"For AWS Backup pricing details, visit AWS Backup pricing"},{"kind":"p","text":"SAP Configuration Management"},{"kind":"li","text":"$0.25 USD per configuration check run per application in all AWS regions"},{"kind":"li","text":"Run checks on-demand or on schedule"},{"kind":"li","text":"Configuration check results are retained for 30 days"},{"kind":"h3","text":"Example Pricing Scenario for Configuration Management"},{"kind":"p","text":"If you run three configuration checks weekly on two SAP HANA applications, your monthly cost would be $6.00 USD. This is calculated based on three checks per week, running on two applications, over four weeks, at $0.25 per check (3 checks × 2 applications × 4 weeks × $0.25 = $6.00)."},{"kind":"h3","text":"Additional Information"},{"kind":"li","text":"No charge for registering SAP applications"},{"kind":"li","text":"No minimum fees or upfront commitments required"}],"lemmas":{"systems":["system","systems"],"managers":["manager","managers"],"automations":["automation","automations"],"capabilities":["capability","capabilities"],"manages":["manages","manage"],"managing":["managing","manage"],"managed":["managed","manage"],"operates":["operates","operate"],"operated":["operated","operate"],"operating":["operating","operate"],"applications":["application","applications"],"provides":["provides","provide"],"provided":["provided","provide"],"providing":["providing","provide"],"seamlesses":["seamlesses","seamless"],"integrations":["integration","integrations"],"services":["service","services"],"serviced":["serviced","service"],"servicing":["servicing","service"],"running":["running","run"],"runnings":["running","runnings"],"runs":["run","runs"],"ran":["ran","run"],"availables":["availables","available"],"uses":["use","uses"],"used":["used","use"],"apis":["apis","api"],"sees":["see","sees"],"seeing":["seeing","see"],"saw":["saw","see"],"seen":["seen","see"],"references":["reference","references"],"guides":["guide","guides"],"guided":["guided","guide"],"guiding":["guiding","guide"],"restores":["restores","restore"],"restored":["restored","restore"],"restoring":["restoring","restore"],"databases":["database","databases"],"amazons":["amazon","amazons"],"started":["started","start"],"starteds":["starteds","started"],"starts":["start","starts"],"starting":["starting","start"],"features":["feature","features"],"featuring":["featuring","feature"],"featured":["featured","feature"],"following":["following","follow"],"followings":["following","followings"],"followed":["followed","follow"],"workloads":["workload","workloads"],"registers":["register","registers"],"discovers":["discovers","discover"],"discovering":["discovering","discover"