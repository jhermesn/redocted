{"id":"security-windows-security","corpus":"k8s","title":"Security For Windows Nodes","sourceUrl":"https://kubernetes.io/docs/concepts/security/windows-security/","license":"Kubernetes Documentation © The Kubernetes Authors, licensed CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0/","blocks":[{"kind":"h1","text":"Security For Windows Nodes"},{"kind":"p","text":"This page describes security considerations and best practices specific to the Windows operating system."},{"kind":"h2","text":"Protection for Secret data on nodes"},{"kind":"p","text":"On Windows, data from Secrets are written out in clear text onto the node's local storage (as compared to using tmpfs / in-memory filesystems on Linux). As a cluster operator, you should take both of the following additional measures:"},{"kind":"li","text":"Use file ACLs to secure the Secrets' file location."},{"kind":"li","text":"Apply volume-level encryption using BitLocker."},{"kind":"h2","text":"Container users"},{"kind":"p","text":"RunAsUsername can be specified for Windows Pods or containers to execute the container processes as specific user. This is roughly equivalent to RunAsUser."},{"kind":"p","text":"Windows containers offer two default user accounts, ContainerUser and ContainerAdministrator. The differences between these two user accounts are covered in When to use ContainerAdmin and ContainerUser user accounts within Microsoft's Secure Windows containers documentation."},{"kind":"p","text":"Local users can be added to container images during the container build process."},{"kind":"li","text":"Nano Server based images run as ContainerUser by default"},{"kind":"li","text":"Server Core based images run as ContainerAdministrator by default"},{"kind":"p","text":"Windows containers can also run as Active Directory identities by utilizing Group Managed Service Accounts"},{"kind":"h2","text":"Pod-level security isolation"},{"kind":"p","text":"Linux-specific pod security context mechanisms (such as SELinux, AppArmor, Seccomp, or custom POSIX capabilities) are not supported on Windows nodes."},{"kind":"p","text":"Privileged containers are not supported on Windows. Instead HostProcess containers can be used on Windows to perform many of the tasks performed by privileged containers on Linux."}],"lemmas":{"securities":["security","securities"],"windows":["window","windows"],"nodes":["node","nod","nodes"],"nods":["nod","nods"],"nodded":["nodded","nod"],"nodding":["nodding","nod"],"pages":["page","pages"],"paging":["paging","page"],"describes":["describes","describe"],"described":["described","describe"],"describing":["describing","describe"],"considerations":["consideration","considerations"],"best":["best","good"],"bests":["best","bests"],"bested":["bested","best"],"bestes":["bestes","best","beste"],"besting":["besting","best"],"goods":["good","goods"],"better":["better","good"],"practices":["practice","practices"],"practiced":["practiced","practice"],"practicing":["practicing","practice"],"specifics":["specific","specifics"],"operating":["operating","operate"],"operatings":["operatings","operating"],"operates":["operates","operate"],"operated":["operated","operate"],"systems":["system","systems"],"protections":["protection","protections"],"data":["datum","data"],"secrets":["secret","secrets"],"written":["written","write"],"writtens":["writtens","written"],"writes":["writes","write"],"writing":["writing","write"],"wrote":["wrote","write"],"clears":["clear","clears"],"cleared":["cleared","clear"],"clearing":["clearing","clear"],"texts":["text","texts"],"ontos":["ontos","onto"],"node's":["node"],"locals":["local","locals"],"storages":["storage","storages"],"compared":["compared","compare"],"compareds":["compareds","compared"],"compares":["compare","compares"],"comparing":["comparing","compare"],"using":["using","use"],"usings":["using","usings"],"uses":["use","uses"],"tmpfs":["tmpfs","tmpf"],"memories":["memory","memories"],"filesystems":["filesystems","filesystem"],"l